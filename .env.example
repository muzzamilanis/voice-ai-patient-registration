# Application
APP_NAME=Voice AI Patient Registration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# Database (SQLite file persists across restarts)
DATABASE_URL=sqlite:///./data/patients.db

# Optional: used by the LLM-backed voice simulator and Vapi custom-LLM proxy
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Vapi webhook shared secret (sent as x-vapi-secret)
VAPI_WEBHOOK_SECRET=

# Optional: restrict mutating API calls from the voice agent
VOICE_API_TOKEN=
